# ==============================================================================
# HIMALYAN WHEELS — BACKEND & ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and insert your real credentials.
# Set these variables in your Vercel Project Settings (Settings -> Environment Variables).
#
# IMPORTANT SECURITY NOTICE:
# - Never commit the .env file containing real secrets to GitHub.
# - Never prefix private backend secrets (MongoDB URI, Cloudinary Secret) with VITE_.
# - Only VITE_ variables are bundled into frontend client JavaScript.
# ==============================================================================

# MongoDB Atlas Connection String
# Obtain from MongoDB Atlas -> Cluster -> Connect -> Drivers -> Node.js
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/himalyanwheels?retryWrites=true&w=majority

# Cloudinary Configuration
# Obtain from Cloudinary Dashboard -> Account Details (Cloud Name, API Key, API Secret)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Optional: Port for local Express server (defaults to 5000 if not specified)
PORT=5000

# Optional: Base URL for Express API
# Leave blank when deploying everything together to Vercel (uses relative /api routes automatically).
# Only set this if hosting the Express API on a separate domain (e.g. https://api.yourdomain.com).
API_BASE_URL=
VITE_API_BASE_URL=
